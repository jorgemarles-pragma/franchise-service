# ==============================================================================
# Environment Configuration Template for Staging
# ==============================================================================
# In accordance with Nequi Security & IaC Pillars:
# Secrets MUST NEVER be committed to version control or hardcoded in plaintext.
#
# In AWS ECS Fargate:
# These values are injected at container startup via the ECS Task Definition
# 'secrets' block referencing AWS Secrets Manager ARNs:
#
#   "secrets": [
#     { "name": "DB_HOST", "valueFrom": "arn:aws:secretsmanager:<region>:<account>:secret:<secret-name>:host::" },
#     { "name": "DB_PORT", "valueFrom": "arn:aws:secretsmanager:<region>:<account>:secret:<secret-name>:port::" },
#     { "name": "DB_NAME", "valueFrom": "arn:aws:secretsmanager:<region>:<account>:secret:<secret-name>:dbname::" },
#     { "name": "DB_USER", "valueFrom": "arn:aws:secretsmanager:<region>:<account>:secret:<secret-name>:username::" },
#     { "name": "DB_PASSWORD", "valueFrom": "arn:aws:secretsmanager:<region>:<account>:secret:<secret-name>:password::" }
#   ]
# ==============================================================================

SPRING_PROFILES_ACTIVE=staging

# Reactive Database Configuration (R2DBC)
DB_HOST=staging-postgres-aurora.cluster-xxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=franchise_staging
DB_SCHEMA=public
DB_USER=franchise_app_user
DB_PASSWORD=YOUR_STAGING_SECRETS_MANAGER_ROTATED_PASSWORD

# JVM Memory and System Tuning
JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:InitialRAMPercentage=50.0 -XX:+ExitOnOutOfMemoryError -Djava.security.egd=file:/dev/./urandom -Duser.timezone=America/Bogota
