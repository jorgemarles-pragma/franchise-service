# Copy this file to terraform.tfvars and fill in your values
# WARNING: NEVER commit terraform.tfvars containing real passwords to version control!

aws_region        = "us-east-1"
project_name      = "franchise-service"
environment       = "staging"
vpc_cidr          = "10.0.0.0/16"
availability_zones = ["us-east-1a", "us-east-1b"]

# Database settings
db_name           = "franchise_staging"
db_user           = "franchise_app_user"
# db password se lee desde variable de entorno
db_instance_class = "db.t4g.micro"

# Application settings
image_tag         = "latest"
fargate_cpu       = 512
fargate_memory    = 1024
desired_count     = 2
